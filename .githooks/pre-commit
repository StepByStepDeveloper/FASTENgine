#!/usr/bin/env bash
# Pre-commit gate: advisory context-tree and documentation-tree checks, and a
# blocking secret scan.
#
# Specifications: .agents/hooks/verify-rules-on-edit.md (the context tree —
# the same gate CI runs; it prints a problem and lets the commit through, so
# flip its closing `exit 0` to `exit "$status"` once the tree has been green
# for a round), .agents/hooks/docs-gate-on-edit.md (the documentation tree —
# advisory in the same way) and .agents/hooks/secret-scan-on-commit.md (the
# secret scan — a finding blocks the commit).
#
# Enable once per clone: git config core.hooksPath .githooks

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# Secret scan — any staged change, in any path; blocking.
if ! python3 .githooks/check_secrets.py; then
    echo "pre-commit: the secret scan reported a problem — the commit is blocked."
    exit 1
fi

status=0

if git diff --cached --name-only | grep -qE '^(AGENTS\.md|\.agents/)'; then
    python3 .agents/skills/verify-rules/scripts/verify_rule_docs.py \
        .agents --group block --compiler clang++ --std c++17 || status=1
    python3 .agents/skills/verify-rules/scripts/check_heading_numbering.py \
        .agents/rules/style/naming.md -r .agents/rules || status=1
    python3 .agents/skills/verify-rules/scripts/check_context_layout.py \
        --root .agents --repo . || status=1

    if [ "$status" -ne 0 ]; then
        echo "pre-commit: the context tree gate reported a problem (advisory — the commit continues)."
    fi
fi

# Documentation tree — staged docs/ or tools/ changes; advisory for now.
if git diff --cached --name-only | grep -qE '^(docs/|tools/)'; then
    if ! python3 tools/check_docs.py; then
        echo "pre-commit: the documentation tree check reported a problem (advisory — the commit continues)."
    fi
fi

exit 0
