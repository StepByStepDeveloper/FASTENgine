#!/usr/bin/env bash
# Pre-commit gate: advisory context-tree and documentation-tree checks, and a
# blocking secret scan.
#
# Specifications: .agents/hooks/verify-rules-on-edit.md (the context tree and
# the development conventions), .agents/hooks/spec-gate-on-edit.md (the
# specifications) and .agents/hooks/docs-gate-on-edit.md (the documentation
# tree) — all advisory in the same way: a problem is printed and the commit
# continues, so flip the closing `exit 0` to `exit "$status"` once the trees
# have been green for a round. .agents/hooks/secret-scan-on-commit.md is the
# secret scan — a finding blocks the commit.
#
# Enable once per clone: git config core.hooksPath .githooks

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# Secret scan — any staged change, in any path; blocking.
if ! python3 .githooks/check_secrets.py; then
    echo "pre-commit: the secret scan reported a problem — the commit is blocked."
    exit 1
fi

status=0

if git diff --cached --name-only | grep -qE '^(AGENTS\.md|\.agents/|docs/development/)'; then
    python3 .agents/skills/verify-rules/scripts/verify_rule_docs.py \
        .agents docs/development --group block --compiler clang++ --std c++17 || status=1
    python3 .agents/skills/verify-rules/scripts/check_heading_numbering.py \
        docs/development/conventions/style/naming.md -r docs/development/conventions || status=1
    python3 .agents/skills/verify-rules/scripts/check_context_layout.py \
        --root .agents --repo . || status=1
fi

# Specifications — staged docs/specs/ changes; advisory in the same way.
if git diff --cached --name-only | grep -qE '^docs/specs/'; then
    python3 tools/spec_check.py docs/specs || status=1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: a gate reported a problem (advisory — the commit continues)."
fi

# Documentation tree — staged docs/ or tools/ changes; advisory for now.
if git diff --cached --name-only | grep -qE '^(docs/|tools/)'; then
    if ! python3 tools/check_docs.py; then
        echo "pre-commit: the documentation tree check reported a problem (advisory — the commit continues)."
    fi
fi

exit 0
