# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories (root-level — anchored so the patterns cannot swallow
# nested paths such as .agents/skills/build-api-docs/)
/build/
/Build/
/build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# IDE files
*.code-workspace

# Bazel (bazel-out/, bazel-bin/, bazel-testlogs/ convenience symlinks)
bazel-*

# doit task-runner state and Python caches
.doit.db*
__pycache__/
*.pyc

# Documentation renders (generated from docs/arc42/diagrams/*.puml by doit diagrams)
docs/arc42/images/*.svg

# Obsidian vault
.obsidian/

# Agent session state (per-clone working note — the committed counterpart is .agents/state/memory.md)
.agents/state/scratchpad.md
