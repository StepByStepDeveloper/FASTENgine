# Doxygen configuration for FASTENgine.
#
# The rules it makes machine-checkable live in .agents/rules/style/documentation.md;
# this file only wires them to the tool: `doxygen Doxyfile` must report no warning
# for an undocumented entity. Raise WARN_AS_ERROR to FAIL_ON_WARNINGS in a CI step
# once the engine sources exist.
#
# `EXTRACT_ALL` stays NO: with YES, doxygen disables the warnings about
# undocumented members, which is exactly the check this file exists for.

PROJECT_NAME           = "FASTENgine"
OUTPUT_DIRECTORY       = build
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
EXCLUDE_PATTERNS       = */bazel-*

EXTRACT_ALL            = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

QUIET                  = YES
JAVADOC_AUTOBRIEF      = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
